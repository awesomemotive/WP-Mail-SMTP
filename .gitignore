.idea/
/build/
node_modules/
/vendor/
/vendor_prefixed/
/php-scoper/vendor/
/tests/vendor/
.phpcs-cache
*.hot-update.json
*.hot-update.js
.env
.review-duet/
.ai-dev-tmp/

# AI QA per-run output. The scaffolding + README under .github/qa/sessions/
# stay tracked; the generated files never are.
.github/qa/sessions/qa-session-*.md
.github/qa/evidence/
.github/qa/reports/

# AI QA run scratch inside the plugin checkout. Upstream gets these for free
# from an ignore-everything .gitignore; this repo lists them.
qa-output/
qa-restore/
playwright-artifacts/
.playwright-cli/
.playwright-mcp/

# Husky internals (auto-generated by `prepare` script)
.husky/_/

# Composer auth token. `composer config github-oauth.github.com <token>` writes
# it here, and a local one is a real PAT, so it must never be committable.
auth.json
